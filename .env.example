GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.7-flash

# Open-model backend (the "local" option in the UI). Leave unset to use llama-server in WSL (start_local_llm.sh).
# To use a hosted OpenAI-compatible provider instead, set all three, for example:
# LOCAL_LLM_URL=https://api.groq.com/openai
# LOCAL_LLM_KEY=your-provider-key
# LOCAL_LLM_MODEL=qwen/qwen3-32b   (any model id from the provider's model list)
