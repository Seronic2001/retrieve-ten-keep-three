# What `railway up` uploads. This folder is not a git repository, so the CLI does not apply .gitignore;
# without this file it sent .venv (~700 MB) and node_modules. Mirrors .dockerignore.
.env
.venv/
**/__pycache__/
**/.ipynb_checkpoints/
**/node_modules/
app/ui/dist/
app/uploads/*
!app/uploads/library.json
!app/uploads/a914ab3a3b.*
report/
notebook/*.ipynb
